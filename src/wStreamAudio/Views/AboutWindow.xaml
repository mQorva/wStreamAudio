<Window
    x:Class="wStreamAudio.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Über wStreamAudio">

    <!-- Hintergrund bewusst transparent — Mica vom Window schimmert durch.
         Sonst zeichnet Windows die Titelzeile auf Mica und der Inhalt sitzt auf einer
         soliden Layer-Farbe; das ergibt eine sichtbare Naht („halber Rahmen oben"). -->
    <Grid x:Name="RootGrid"
          Padding="20" ColumnSpacing="16" RowSpacing="2"
          Background="Transparent"
          PointerPressed="RootGrid_PointerPressed"
          ToolTipService.ToolTip="zum Schließen klicken">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image
            Grid.Column="0" Grid.RowSpan="5"
            x:Name="LogoImage"
            Width="56" Height="56"
            VerticalAlignment="Top"
            Margin="0,2,0,0"/>

        <TextBlock Grid.Column="1" Grid.Row="0"
                   Text="wStreamAudio"
                   Style="{ThemeResource SubtitleTextBlockStyle}"/>

        <TextBlock Grid.Column="1" Grid.Row="1"
                   x:Name="VersionText"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <TextBlock Grid.Column="1" Grid.Row="2"
                   x:Name="DescriptionText"
                   Style="{ThemeResource BodyTextBlockStyle}"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Column="1" Grid.Row="4"
                   x:Name="CopyrightText"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="0,16,0,0"/>
    </Grid>
</Window>
