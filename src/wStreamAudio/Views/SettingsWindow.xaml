<Window
    x:Class="wStreamAudio.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Win11-Stil-Titelzeile: links App-Icon + Titel/Version, rechts reserviert für die
             nativen System-Buttons (Min/Max/Close). Die ganze Zeile ist Drag-Region; das
             RightInset des AppWindow.TitleBar wird per Code als Padding gespiegelt. -->
        <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent" Padding="12,0,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" x:Name="TitleBarRightInsetCol" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0"
                   Source="ms-appx:///Assets/App16.png"
                   Width="16" Height="16"
                   VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       x:Name="TitleBarText"
                       Text="wStreamAudio"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <muxc:NavigationView Grid.Row="1" x:Name="Nav"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             PaneDisplayMode="Left"
                             OpenPaneLength="220"
                             IsTitleBarAutoPaddingEnabled="False"
                             SelectionChanged="Nav_SelectionChanged"
                             Background="Transparent">
            <muxc:NavigationView.Resources>
                <!-- Content-Surface der NavigationView durchsichtig machen, damit der
                     Mica-Hintergrund von links durch den Pane bis rechts in den Inhalt
                     durchscheint. Sonst sitzt rechts eine separate „Karte" auf der Mica-Schicht. -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentMargin">0,0,0,0</Thickness>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
            </muxc:NavigationView.Resources>
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem x:Name="NavGeneral" Tag="general">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavAudio" Tag="audio">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Microphone" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavLms" Tag="lms">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="World" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavStreaming" Tag="streaming">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Audio" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavAbout" Tag="about">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Grid Padding="24,12,24,24" RowSpacing="12" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           x:Name="HeaderText"
                           Style="{ThemeResource TitleTextBlockStyle}"
                           Text="Einstellungen" />
                <Frame Grid.Row="1" x:Name="ContentFrame" Background="Transparent" />
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
