<Page
    x:Class="wStreamAudio.Views.Settings.AudioSourcePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Background="Transparent">

    <Grid RowSpacing="12" Padding="0,0,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Audio-Quellen" />
            <TextBlock TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Text="Quellen bestimmen, was für den Stream abgegriffen wird. Doppelklick öffnet den Editor. Mit &#x201E;als Standard&#x201C; wird die aktive Quelle gesetzt." />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <ListView x:Name="ProfilesList"
                      SelectionMode="Single"
                      SelectionChanged="ProfilesList_SelectionChanged"
                      DoubleTapped="ProfilesList_DoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Grid.Column="0" Symbol="Audio" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{Binding ModeText}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Marker}"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       ToolTipService.ToolTip="aktive Quelle" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Content="neue Quelle"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="AddProfile_Click" />
            <Button Content="bearbeiten …" Click="EditProfile_Click" />
            <Button Content="als Standard" Click="SetDefault_Click" />
            <Button Content="löschen" Click="DeleteProfile_Click" />
        </StackPanel>
    </Grid>
</Page>
