<Page
    x:Class="wStreamAudio.Views.Settings.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Background="Transparent">

    <ScrollViewer Padding="0,0,16,0"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="6">
            <tk:SettingsCard Header="Version"
                             x:Name="VersionCard">
                <TextBlock x:Name="VersionText" Style="{ThemeResource BodyTextBlockStyle}" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Lizenz"
                             Description="Diese App steht unter MIT-Lizenz.">
                <HyperlinkButton Content="Lizenz öffnen" Click="OpenLicense_Click" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Drittanbieter-Komponenten"
                             Description="Liste aller eingebundenen NuGet-Pakete.">
                <HyperlinkButton Content="Drittanbieter-Hinweise öffnen" Click="OpenThirdParty_Click" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Lokale Daten"
                             Description="Pfade zu Settings und Logs.">
                <StackPanel>
                    <TextBlock x:Name="DataPathText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="LogsPathText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               IsTextSelectionEnabled="True" />
                </StackPanel>
            </tk:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
