<Page
    x:Class="wStreamAudio.Views.Settings.StreamingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Background="Transparent">

    <Page.Resources>
        <!-- Ein gemeinsames Template für alle drei Renderer-Listen (LMS, DLNA, AirPlay).
             Bindings nutzen die vereinheitlichten Property-Namen:
             Id, DisplayName, StatusText, ProtocolText/ProtocolBadgeVisible,
             IsEnabled, InSyncGroup, CanToggleEnabled, SpeakerGlyph, CardOpacity, VolumePercent. -->
        <DataTemplate x:Key="RendererCardTemplate">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16,14">
                <Grid ColumnSpacing="12" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <!-- aktiv-CheckBox | Name+Status (*) | Speaker | Edit | Delete -->
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              IsEnabled="{Binding CanToggleEnabled}"
                              Content="aktiv"
                              VerticalAlignment="Center"
                              MinWidth="0"
                              ToolTipService.ToolTip="Bei &#x201E;aus&#x201C; verschwindet das Gerät aus dem Mini-Fenster." />

                    <StackPanel Grid.Row="0" Grid.Column="1"
                                VerticalAlignment="Center" Spacing="2"
                                Opacity="{Binding CardOpacity}">
                        <TextBlock Text="{Binding DisplayName}"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding StatusText}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="3"
                                    Padding="6,1"
                                    Visibility="{Binding ProtocolBadgeVisible}">
                                <TextBlock Text="{Binding ProtocolText}"
                                           FontSize="10"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ToggleButton statt Button: bei IsChecked=true zeichnet das Theme die
                         Karte automatisch Accent-blau — visueller „aktiv"-Zustand wie im Mini. -->
                    <ToggleButton Grid.Row="0" Grid.Column="2"
                                  IsChecked="{Binding InSyncGroup, Mode=TwoWay}"
                                  IsEnabled="{Binding CanToggleEnabled}"
                                  Opacity="{Binding CardOpacity}"
                                  ToolTipService.ToolTip="Stream auf diesem Gerät abspielen / anhalten">
                        <FontIcon Glyph="{Binding SpeakerGlyph}" />
                    </ToggleButton>
                    <Button Grid.Row="0" Grid.Column="3"
                            ToolTipService.ToolTip="umbenennen"
                            Tag="{Binding Id}"
                            Click="Card_Rename_Click">
                        <SymbolIcon Symbol="Edit" />
                    </Button>
                    <Button Grid.Row="0" Grid.Column="4"
                            ToolTipService.ToolTip="aus der Liste entfernen"
                            Tag="{Binding Id}"
                            Click="Card_Forget_Click">
                        <SymbolIcon Symbol="Delete" />
                    </Button>

                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" ColumnSpacing="12"
                          Opacity="{Binding CardOpacity}"
                          IsHitTestVisible="{Binding IsEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Pegel:" VerticalAlignment="Center" />
                        <Slider Grid.Column="1"
                                Minimum="0" Maximum="100"
                                Value="{Binding VolumePercent, Mode=TwoWay}"
                                ToolTipService.ToolTip="0–100 %" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding VolumePercent}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="0,0,16,0"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4">
            <!-- Globaler Stream-Schalter, prominent ganz oben. Klick startet/stoppt die
                 komplette Pipeline (Squeeze-Sync-Gruppe, DLNA, AirPlay). -->
            <Grid Margin="0,0,0,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Stream" />
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="Master-Schalter — startet die Aufnahme und spielt auf allen aktivierten Geräten." />
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="StreamToggleButton"
                        Click="StreamToggleButton_Click"
                        Style="{ThemeResource AccentButtonStyle}"
                        MinWidth="140" Height="40"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <SymbolIcon x:Name="StreamToggleIcon" Symbol="Play" />
                        <TextBlock x:Name="StreamToggleText" Text="abspielen" />
                    </StackPanel>
                </Button>
            </Grid>

            <tk:SettingsCard Header="Audio-Pegel (Aufnahme)"
                             Description="Spitzenpegel der laufenden Aufnahme. Bewegt sich der Balken nicht, kommt aus dem gewählten Endpoint kein Audio."
                             ContentAlignment="Vertical">
                <StackPanel Spacing="6" MinWidth="320">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="L"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ProgressBar Grid.Column="1" x:Name="LevelLeftBar"
                                     Minimum="0" Maximum="1" Value="0" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="R"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ProgressBar Grid.Column="1" x:Name="LevelRightBar"
                                     Minimum="0" Maximum="1" Value="0" />
                    </Grid>
                    <TextBlock x:Name="LevelStatusText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Stream nicht aktiv." />
                </StackPanel>
            </tk:SettingsCard>

            <Grid x:Name="SqueezeBoxHeaderGrid" Margin="0,20,0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="SqueezeBox" />
                    <TextBlock x:Name="PlayersHint"
                               TextWrapping="Wrap"
                               MinHeight="20"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>
                <Button Grid.Column="1"
                        VerticalAlignment="Top"
                        Content="Player vom LMS neu laden"
                        Click="RefreshPlayers_Click" />
            </Grid>

            <ListView x:Name="PlayersList" Margin="0,0,0,12"
                      ItemTemplate="{StaticResource RendererCardTemplate}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      CanReorderItems="True"
                      AllowDrop="True"
                      CanDragItems="True"
                      DragItemsCompleted="PlayersList_DragItemsCompleted">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <Grid x:Name="DlnaHeaderGrid" Margin="0,12,0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="DLNA-Renderer (direkt)" />
                    <TextBlock x:Name="DlnaHint"
                               TextWrapping="Wrap"
                               MinHeight="20"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Text="Direkt-Wiedergabe ohne LMS — gut für einzelne Geräte (Smart-TV, AVR), aber NICHT sample-synchron mit Squeeze-Playern." />
                </StackPanel>
                <Button x:Name="DlnaDiscoverButton"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Content="Renderer im LAN suchen"
                        Click="DlnaDiscover_Click" />
            </Grid>

            <ListView x:Name="DlnaList"
                      ItemTemplate="{StaticResource RendererCardTemplate}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      CanReorderItems="True"
                      AllowDrop="True"
                      CanDragItems="True"
                      DragItemsCompleted="DlnaList_DragItemsCompleted">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- AirPlay-Empfänger direkt — Discovery jetzt, Senden folgt in der nächsten Iteration. -->
            <Grid x:Name="AirPlayHeaderGrid" Margin="0,16,0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock x:Name="AirPlayHeader"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               Text="AirPlay-Empfänger (direkt)" />
                    <TextBlock x:Name="AirPlayHint"
                               TextWrapping="Wrap"
                               MinHeight="20"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Text="HomePod, Apple TV, AirPort Express, AirPlay-AVRs. Aktuell nur Discovery — direktes Streamen folgt." />
                </StackPanel>
                <Button x:Name="AirPlayDiscoverButton"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Content="Empfänger im LAN suchen"
                        Click="AirPlayDiscover_Click" />
            </Grid>

            <ListView x:Name="AirPlayList"
                      ItemTemplate="{StaticResource RendererCardTemplate}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      CanReorderItems="True"
                      AllowDrop="True"
                      CanDragItems="True"
                      DragItemsCompleted="AirPlayList_DragItemsCompleted">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
