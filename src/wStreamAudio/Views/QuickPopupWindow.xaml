<Window
    x:Class="wStreamAudio.Views.QuickPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:wStreamAudio.ViewModels">

    <Grid x:Name="RootGrid" Padding="0,0,0,6" RowSpacing="2">
        <Grid.RowDefinitions>
            <!-- Titelzeile mit Play-Icon, Status-Text, Pin, Close -->
            <RowDefinition Height="36" />
            <!-- Player-Liste — Auto, damit das Fenster sich exakt an die Anzahl der Player anpasst. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Titelzeile = drag-fähige Region (DragRegion); Buttons unterbrechen die Drag-Zone. -->
        <Grid Grid.Row="0"
              x:Name="DragRegion"
              Background="Transparent"
              Padding="8,0,4,0"
              ColumnSpacing="2"
              DoubleTapped="DragRegion_DoubleTapped">
            <Grid.ColumnDefinitions>
                <!-- App-Icon links (Titelbar-Konvention Win11). -->
                <ColumnDefinition Width="Auto" />
                <!-- Play-Button, etwas nach rechts gerückt. -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0"
                   Source="ms-appx:///Assets/App16.png"
                   Width="16" Height="16"
                   Margin="4,0,8,0"
                   VerticalAlignment="Center" />
            <!-- Schlanker Play/Pause-Icon-Button — kein Accent-Block, das Default-Hover/Pressed
                 vom Theme liefert das Klick-Feedback. -->
            <Button Grid.Column="1"
                    x:Name="PlayPauseButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4"
                    Margin="4,0,0,0"
                    Width="32" Height="32"
                    ToolTipService.ToolTip="Stream abspielen / anhalten"
                    Click="PlayPauseButton_Click">
                <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="16" />
            </Button>
            <TextBlock Grid.Column="2"
                       x:Name="PlayPauseText"
                       Text="abspielen"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       VerticalAlignment="Center"
                       IsTapEnabled="True"
                       Tapped="PlayPauseText_Tapped"
                       ToolTipService.ToolTip="Stream abspielen / anhalten" />
            <Button Grid.Column="3"
                    x:Name="PinToggle"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4"
                    Width="32" Height="32"
                    ToolTipService.ToolTip="fixieren (bleibt bei Klick außerhalb offen)"
                    Click="PinToggle_Click">
                <FontIcon x:Name="PinIcon" Glyph="&#xE77A;" FontSize="14" Opacity="0.7" />
            </Button>
            <Button Grid.Column="4"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4"
                    Width="32" Height="32"
                    ToolTipService.ToolTip="schließen"
                    Click="CloseButton_Click">
                <FontIcon Glyph="&#xE10A;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Player-Liste, kompakt: kleines Power-Icon, Name (gekürzt), breiter Slider, % -->
        <ItemsControl Grid.Row="1" x:Name="PlayerList" Margin="10,0,10,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="0" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlayerListItemViewModel">
                    <Grid Padding="0,0" ColumnSpacing="0" Height="30">
                        <Grid.ColumnDefinitions>
                            <!-- Power-Button (Lautsprecher / durchgestrichen) -->
                            <ColumnDefinition Width="22" />
                            <!-- Player-Name, schmal → Slider bekommt mehr Platz -->
                            <ColumnDefinition Width="78" />
                            <!-- Lautstärke-Slider -->
                            <ColumnDefinition Width="*" />
                            <!-- Prozent-Anzeige -->
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Grid.Column="0"
                                      IsChecked="{x:Bind IsPowered, Mode=TwoWay}"
                                      Width="22" Height="22"
                                      Padding="0"
                                      MinWidth="0" MinHeight="0"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      ToolTipService.ToolTip="Player ein/aus">
                            <FontIcon Glyph="{x:Bind PowerGlyph, Mode=OneWay}" FontSize="12" />
                        </ToggleButton>
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind DisplayName, Mode=OneWay}"
                                   FontSize="12"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Slider Grid.Column="2"
                                Minimum="0" Maximum="100"
                                Value="{x:Bind EffectiveVolume, Mode=TwoWay}"
                                IsEnabled="{x:Bind IsConnected, Mode=OneWay}"
                                VerticalAlignment="Center"
                                Margin="2,0,2,0"
                                MinWidth="0" />
                        <TextBlock Grid.Column="3"
                                   Text="{x:Bind EffectiveVolume, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   TextAlignment="Right"
                                   MinWidth="20" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <HyperlinkButton Grid.Row="2"
                         Content="Einstellungen"
                         HorizontalAlignment="Right"
                         Margin="0,0,10,0"
                         FontSize="11"
                         Padding="4,2"
                         Click="OpenSettings_Click" />
    </Grid>
</Window>
